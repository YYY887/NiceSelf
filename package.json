{
  "name": "front-myself",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "cloudflare": {
    "label": "QianQiu-MySelf",
    "products": [
      "Workers",
      "D1",
      "R2"
    ],
    "categories": [
      "starter"
    ],
    "docs_url": "https://github.com/YYY887/NiceSelf#一键部署到-cloudflare",
    "bindings": {
      "DB": {
        "description": "内容数据库（D1）。一键部署会按 `wrangler.toml` 里的 `database_name` 自动新建并绑定，无需手动创建。"
      },
      "UPLOADS": {
        "description": "上传文件与备份存储（R2）。一键部署会自动新建名为 `qianqiu-uploads` 的存储桶并绑定。"
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "cd server && go run ./cmd/api",
    "dev:full": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev\"",
    "test:api": "cd server && go test ./...",
    "dev:worker": "wrangler dev",
    "deploy": "npm run build && wrangler deploy && node scripts/capture-deploy.mjs",
    "deploy:cf": "npm run db:migrate:remote && wrangler deploy && node scripts/capture-deploy.mjs",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@milkdown/crepe": "^7.22.3",
    "@milkdown/kit": "^7.22.3",
    "@rexa-developer/tiks": "^0.3.0",
    "@tailwindcss/vite": "^4",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "hono": "^4.13.16",
    "lucide-react": "^1.61.0",
    "marked": "^18.1.2",
    "motion": "^14.5.0",
    "prism-react-renderer": "^2.4.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0",
    "web-haptics": "^0.0.6",
    "yuque-rich-text": "^1.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6",
    "concurrently": "^10.0.6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8",
    "wrangler": "^4.156.1"
  }
}
