# Copy this file to server/.env and fill in GitHub OAuth App credentials for comments.
# OAuth App callback URL: http://127.0.0.1:5173/api/auth/github/callback
PORT=8080
DATABASE_PATH=data/site.db
PUBLIC_URL=http://127.0.0.1:5173
# Used only when the database has no admin account yet. After first start, change them in /admin settings.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=qianqiu123
# Optional fallback. Prefer setting these in /admin/settings after login.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional token for a higher GitHub API rate limit. Never expose it in Vite env vars.
GITHUB_TOKEN=
SESSION_DAYS=30
# After npm run build, set STATIC_DIR=../dist and PUBLIC_URL to this Go server's public origin.
# STATIC_DIR=../dist
